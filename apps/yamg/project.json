{
  "name": "yamg",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "yamg",
  "sourceRoot": "apps/yamg/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/yamg/browser"],
      "options": {
        "command": "vp build",
        "cwd": "apps/yamg"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "vp dev",
        "cwd": "apps/yamg"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "vp preview",
        "cwd": "apps/yamg"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vp run typecheck"
      }
    },
    "tauri-dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "vp exec tauri dev",
        "cwd": "apps/yamg"
      }
    },
    "tauri-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vp exec tauri build",
        "cwd": "apps/yamg"
      }
    }
  }
}
